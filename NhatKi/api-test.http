### 1. Test server
GET {{baseUrl}}/

### 2. Register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "testuser",
  "email": "test@gmail.com",
  "password": "123456"
}

### 3. Login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "test@gmail.com",
  "password": "123456"
}

### 4. Get my info (paste token first)
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

### 5. Create group
POST {{baseUrl}}/groups
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Nhóm diary",
  "description": "Nhóm test"
}

### 6. Join group (paste inviteCode)
POST {{baseUrl}}/groups/join
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "inviteCode": "PASTE_CODE_HERE"
}
### 7. Create diary
POST {{baseUrl}}/diary
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "My first diary",
  "content": "Today was a great day!",
  "mood": "happy",
  "visibility": "public",
  "entryDate": "2024-06-05"
}

### 8. Get timeline
GET {{baseUrl}}/diary/timeline
Authorization: Bearer {{token}}

### 9. Get group feed (paste groupId)
GET {{baseUrl}}/feed/group/384319bc-b3ac-4620-87ea-231a2e4634a7
Authorization: Bearer {{token}}

### 10. Attach tag (paste diaryId)
POST {{baseUrl}}/diary/76e18b9c-713f-4312-9559-2897fc5844e0/tags
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "tag_name": "happy"
}

### 11. Search by tag
GET {{baseUrl}}/diary/search?tag=happy
Authorization: Bearer {{token}}

### 12. Add reaction (paste diaryId)
POST {{baseUrl}}/diary/76e18b9c-713f-4312-9559-2897fc5844e0/reactions
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "type": "like"
}

### 13. Add comment (paste diaryId)
POST {{baseUrl}}/diary/76e18b9c-713f-4312-9559-2897fc5844e0/comments
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "content": "This is a comment!"
}
### 14. Create capsule
POST {{baseUrl}}/capsules
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "My first time capsule",
  "content": "This is a memory for the future!",
  "openAt": "2026-12-31T00:00:00.000Z"
}

### 15. Get all capsules
GET {{baseUrl}}/capsules
Authorization: Bearer {{token}}

### 16. Get one capsule (paste capsuleId)
GET {{baseUrl}}/capsules/f0e0021d-bed4-4bcf-904c-b3e607b74c2a
Authorization: Bearer {{token}}

### 17. Add media/wish to capsule (paste capsuleId)
POST {{baseUrl}}/capsules/f0e0021d-bed4-4bcf-904c-b3e607b74c2a/media
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "url": "https://example.com/photo.jpg",
  "type": "image",
  "filename": "photo.jpg",
  "wishMessage": "Hope you are happy when you read this!"
}

### 18. Open capsule (paste capsuleId)
POST {{baseUrl}}/capsules/f0e0021d-bed4-4bcf-904c-b3e607b74c2a/open
Authorization: Bearer {{token}}

### 19. Get received capsules
GET {{baseUrl}}/capsules/received
Authorization: Bearer {{token}}