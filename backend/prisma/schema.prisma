datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique
  email        String        @unique
  password     String
  avatar       String?
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
  capsules     Capsule[]     @relation("CreatorRelation")
  receivedCaps Capsule[]     @relation("ReceiverRelation")
  groupMembers GroupMember[]
  notifications Notification[]
  media        Media[]

  @@map("users")
}

model Group {
  id           String        @id @default(uuid())
  name         String
  description  String?
  ownerId      String        @map("owner_id")
  inviteCode   String?       @unique @map("invite_code")
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
  groupMembers GroupMember[]
  media        Media[]

  @@map("groups")
}

enum GroupRole {
  owner
  member
}

model GroupMember {
  userId   String    @map("user_id")
  groupId  String    @map("group_id")
  role     GroupRole @default(member)
  joinedAt DateTime  @default(now()) @map("joined_at")
  user     User      @relation(fields: [userId], references: [id])
  group    Group     @relation(fields: [groupId], references: [id])

  @@id([userId, groupId])
  @@map("group_members")
}

model Capsule {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  receiverId String?   @map("receiver_id")
  title      String
  content    String?
  open_at    DateTime  @map("open_at")
  isOpened   Boolean   @default(false) @map("is_opened")
  status     String    @default("locked")
  isNotified Boolean   @default(false) @map("is_notified")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  creator    User      @relation("CreatorRelation", fields: [userId], references: [id])
  receiver   User?     @relation("ReceiverRelation", fields: [receiverId], references: [id])

  @@map("capsules")
}

model GroupActivity {
  id           String   @id @default(uuid())
  groupId      String   @map("group_id")
  userId       String   @map("user_id")
  activityType String   @map("activity_type")
  details      String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("group_activities")
}

model Media {
  id           String   @id @default(uuid())
  publicId     String   @unique @map("public_id")
  url          String
  resourceType String   @map("resource_type")
  format       String?
  sizeBytes    Int?     @map("size_bytes")
  ownerId      String   @map("owner_id")
  groupId      String   @map("group_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  owner        User     @relation(fields: [ownerId], references: [id])
  group        Group    @relation(fields: [groupId], references: [id])

  @@index([groupId, createdAt])
  @@index([ownerId])
  @@map("media")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  capsuleId String?   @map("capsule_id")
  type      String
  title     String
  body      String    @db.Text
  channel   String    @default("push")
  status    String    @default("sent")
  metadata  String?   @db.Text
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([capsuleId])
  @@map("notifications")
}
