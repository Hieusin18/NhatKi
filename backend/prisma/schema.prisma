datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique
  email        String        @unique
  password     String
  avatar       String?
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
  capsules     Capsule[]     @relation("CreatorRelation")
  receivedCaps Capsule[]     @relation("ReceiverRelation")
  groupMembers GroupMember[]

  @@map("users")
}

model Group {
  id           String        @id @default(uuid())
  name         String
  description  String?
  ownerId      String        @map("owner_id")
  inviteCode   String?       @unique @map("invite_code")
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
  groupMembers GroupMember[]

  @@map("groups")
}

model GroupMember {
  userId   String   @map("user_id")
  groupId  String   @map("group_id")
  role     String   @default("member")
  joinedAt DateTime @default(now()) @map("joined_at")
  user     User     @relation(fields: [userId], references: [id])
  group    Group    @relation(fields: [groupId], references: [id])

  @@id([userId, groupId])
  @@map("group_members")
}

model Capsule {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  receiverId String?   @map("receiver_id")
  title      String
  content    String?
  open_at    DateTime  @map("open_at")
  isOpened   Boolean   @default(false) @map("is_opened")
  status     String    @default("locked")
  isNotified Boolean   @default(false) @map("is_notified")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  creator    User      @relation("CreatorRelation", fields: [userId], references: [id])
  receiver   User?     @relation("ReceiverRelation", fields: [receiverId], references: [id])

  @@map("capsules")
}
