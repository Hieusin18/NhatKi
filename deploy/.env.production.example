# =========================================================
# Setlog - Production environment template
# Copy thành .env.production và điền giá trị thật. KHÔNG commit file thật.
# =========================================================

# ---- App ----
NODE_ENV=production
PORT=4000
APP_BASE_URL=https://api.setlog.app

# ---- Registry / Image (CI/CD) ----
REGISTRY=ghcr.io/your-org
IMAGE_TAG=latest

# ---- Database (MySQL) ----
DB_HOST=mysql
DB_PORT=3306
DB_NAME=setlog
DB_USER=setlog
DB_PASSWORD=change_me_strong
DB_ROOT_PASSWORD=change_me_root_strong

# ---- Auth ----
JWT_SECRET=change_me_long_random_string
JWT_EXPIRES_IN=7d

# ---- Redis ----
REDIS_URL=redis://redis:6379

# ---- Cloudinary (media storage) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Firebase Cloud Messaging (push notification) ----
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ---- Map API ----
MAP_API_KEY=

# ---- Sentry (error tracking - đã tích hợp tuần 3) ----
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- Monitoring / Alerts ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
ALERT_SLACK_WEBHOOK=
