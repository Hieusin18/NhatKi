{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile representation in SetLog",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "bio": { "type": "string" },
        "is2FAEnabled": { "type": "boolean" },
        "closeFriendIds": { "type": "array" },
        "blockedUserIds": { "type": "array" },
        "qrCodeToken": { "type": "string" },
        "createdAt": { "type": "number" },
        "fcmToken": { "type": "string" }
      },
      "required": ["id", "username", "displayName", "email"]
    },
    "ActiveSession": {
      "title": "ActiveSession",
      "description": "User session details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "deviceName": { "type": "string" },
        "deviceType": { "type": "string" },
        "ipAddress": { "type": "string" },
        "location": { "type": "string" },
        "lastActiveTime": { "type": "number" },
        "isCurrent": { "type": "boolean" },
        "accessToken": { "type": "string" },
        "refreshToken": { "type": "string" },
        "expiresAt": { "type": "number" }
      }
    },
    "MomentPost": {
      "title": "MomentPost",
      "description": "Moment post object",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "primaryMediaUrl": { "type": "string" },
        "secondaryMediaUrl": { "type": "string" },
        "mediaType": { "type": "string" },
        "caption": { "type": "string" },
        "capturedAt": { "type": "number" },
        "privacy": { "type": "string" },
        "storageTier": { "type": "string" }
      }
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "Friend request between users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fromUserId": { "type": "string" },
        "fromUserName": { "type": "string" },
        "fromUserAvatar": { "type": "string" },
        "toUserId": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "number" }
      }
    },
    "AppNotification": {
      "title": "AppNotification",
      "description": "App notification item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "read": { "type": "boolean" },
        "timestamp": { "type": "number" },
        "userId": { "type": "string" }
      }
    },
    "MediaJob": {
      "title": "MediaJob",
      "description": "Media processing status",
      "type": "object",
      "properties": {
        "jobId": { "type": "string" },
        "filename": { "type": "string" },
        "stage": { "type": "string" },
        "progress": { "type": "number" },
        "userId": { "type": "string" },
        "outputUrls": { "type": "object" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles"
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": "ActiveSession",
      "description": "Active login sessions"
    },
    "/posts/{postId}": {
      "schema": "MomentPost",
      "description": "SetLog posts"
    },
    "/friendRequests/{requestId}": {
      "schema": "FriendRequest",
      "description": "Friend requests"
    },
    "/notifications/{notificationId}": {
      "schema": "AppNotification",
      "description": "User notifications"
    },
    "/mediaJobs/{jobId}": {
      "schema": "MediaJob",
      "description": "Background media transcoding jobs"
    }
  }
}
